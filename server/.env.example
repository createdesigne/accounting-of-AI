# Stay disabled until school usage permission, data sending and costs are confirmed.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_SERVER_PORT=8787
AI_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Set ONLY in the private server environment. Never use VITE_* for secrets.
# Keep blank in this example; do not paste actual keys into chat or Git.
GEMINI_API_KEY=
# Low-cost, non-preview model ID from Google's official examples. Override if needed.
GEMINI_MODEL=gemini-3.5-flash-lite
